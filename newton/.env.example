# PostgreSQL required in production. Leave blank for embedded local development.
DATABASE_URL=
APP_URL=http://localhost:3000
# Explicit opt-in for local/test embedded database, never use on ephemeral hosting.
LOCAL_DATABASE=true
LOCAL_DATA_DIR=.data/postgres
# Set only for the one-time provisioning command. Never commit actual values.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Explicit local-only opt-in; ignored with PostgreSQL or NODE_ENV=production.
LOCAL_BOOTSTRAP=false
# S3-compatible durable media storage (AWS S3, R2, etc.)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_URL=
# Optional administrator email notifications through Resend
RESEND_API_KEY=
NOTIFY_FROM=
# Required in production for contact form spam protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Only set when your reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY=false
